# Global setup leaves project/database unset so the MCP host can route dynamically.
# Use these only as legacy or diagnostic overrides:
# AGENTBRIDGE_PROJECT_PATH=/absolute/path/to/project
# AGENTBRIDGE_DB_PATH=/absolute/path/to/project/.agentbridge/agentbridge.sqlite
AGENTBRIDGE_AGENT=claude
AGENTBRIDGE_CLAUDE_COMMAND=claude
# Codex defaults to GUI-first auto discovery: App Server first, CLI fallback.
AGENTBRIDGE_CODEX_MODE=auto
# Optional executable overrides when auto discovery does not find Codex Desktop.
# AGENTBRIDGE_CODEX_APP_COMMAND=/absolute/path/to/codex
# AGENTBRIDGE_CODEX_COMMAND=/absolute/path/to/codex
# Optional when the selected Codex CLI needs an explicit model override.
# AGENTBRIDGE_CODEX_MODEL=gpt-5.6-sol

# Shared connector and discussion safety limits (milliseconds).
# AGENTBRIDGE_TIMEOUT_MS=120000
# AGENTBRIDGE_MAX_DURATION_MS=1800000
# AGENTBRIDGE_RECOVERY_MAX_AGE_MS=1800000
# AGENTBRIDGE_SESSION_PRUNE_MAX_AGE_MS=2592000000
# Optional global override for successful Provider responses per discussion (1-50).
# Leave unset to use mode defaults: review=3, discussion=12, deep-discussion=20.
# AGENTBRIDGE_MAX_TURNS=12
# Discussion rows are retained forever by default; set 1-3650 for startup cleanup.
# AGENTBRIDGE_DISCUSSION_RETENTION_DAYS=0
# Best-effort native session archival on close/cancel; disabled by default.
# AGENTBRIDGE_ARCHIVE_SESSIONS_ON_CLOSE=0
# Defaults to 1. Set to 0 only when legacy synchronous peer responses are required.
# Automatic discussions complete before ask_peer returns by default.
# Set to 1 only when the caller will explicitly follow nextAction=WAIT.
# AGENTBRIDGE_ASYNC_DISPATCH=0
